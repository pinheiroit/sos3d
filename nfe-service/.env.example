# Porta do serviço
PORT=8787

# Token compartilhado com o site (mesmo valor salvo em NFE_SERVICE_TOKEN no painel)
NFE_SERVICE_TOKEN=troque-por-um-token-forte

# Certificado digital A1
CERT_PATH=./certificado.pfx
CERT_PASSWORD=senha-do-certificado

# Ambiente: 2 = homologação (testes), 1 = produção
NFE_AMBIENTE=2

# Dados da empresa emitente
EMIT_UF=AC
EMIT_CNPJ=00000000000000
EMIT_IE=0000000000
EMIT_RAZAO_SOCIAL=SOS 3D LTDA
EMIT_NOME_FANTASIA=SOS.3D
EMIT_CRT=1
EMIT_LOGRADOURO=Rua Exemplo
EMIT_NUMERO=100
EMIT_BAIRRO=Centro
EMIT_MUNICIPIO=Rio Branco
EMIT_COD_MUNICIPIO=1200401
EMIT_CEP=69900000
EMIT_FONE=6899999999

# Pastas onde os XML e PDF são gravados
STORAGE_DIR=./arquivos
